{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-bi",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist/portfolio-bi/browser",
    // Deep links must serve index.html. Without this an employer who refreshes
    // on /projekt gets a 404 — the one failure mode that costs an application.
    "not_found_handling": "single-page-application"
  }
}
